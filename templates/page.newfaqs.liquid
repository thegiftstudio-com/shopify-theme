{%- style -%}
    .section-template--18201551274291__main-padding {
      padding-top: 28px;
      padding-bottom: 28px;
    }

    @media screen and (min-width: 750px) {
      .section-template--18201551274291__main-padding {
        padding-top: 21px;
        padding-bottom: 21px;
      }
    }
    /* product page accordion Start */
  .row-accordion {
    display: flex;
    margin-top: 15px; }

  .row-accordion .col {
    flex: 1;
    padding: 0px;
    /* Accordion styles */ }

  .row-accordion .col .tabs {
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 3px 4px 0px rgba(0, 0, 0, 0.3); }

  .row-accordion .col .tab {
    width: 100%;
    color: #000;
    overflow: hidden; }

  .row-accordion .col .tab-label {
    display: flex;
    justify-content: space-between;
    padding: 1em;
    background: #fff;
    font-weight: bold;
    cursor: pointer;    line-height: 22px;
    /* Icon */ }

  .row-accordion .col .tab-label:hover {
    background: #e6e6e6; }

  .row-accordion .col .tab-label::after {
    content: "\276F";
    width: 1em;
    height: 1em;
    text-align: center;
    transition: all 0.35s; }

  .row-accordion .col .tab-content {
    max-height: 0;
    padding: 0 1em;
    color: #fff;
    background: white;
    transition: all 0.35s; }
  .row-accordion .col .tab-content ul{
    margin-top: 0;
  }
  .row-accordion .col .tab-close {
    display: flex;
    justify-content: flex-end;
    padding: 1em;
    font-size: 0.75em;
    background: #fff;
    cursor: pointer; }

  .row-accordion .col .tab-close:hover {
    background: #e6e6e6; }

  .row-accordion .col input {
    position: absolute;
    opacity: 0;
    z-index: -1; }

  .row-accordion .col input:checked + .tab-label {
    background: #e6e6e6; }

  .row-accordion .col input:checked + .tab-label::after {
    transform: rotate(90deg); }

  .row-accordion .col input:checked ~ .tab-content {
    max-height: 100vh;
    padding: 1em;
    color: #000; }

  #bcpo .bcpo-checkboxes input[type="checkbox"] {
    height: 20px;
    width: 20px; }

  /* product page accordion End */
{%- endstyle -%}

