{%- comment -%}
  Enquiry Form (Glass) – Diwali / Corporate enquiry section
  Re-uses the existing snippet: snippets/corporate_native_form.liquid
  Note: the snippet uses fixed element IDs, so add only ONE enquiry form
  section (this one or the old "Hulk Enquiry Section") per page.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign img_d = section.settings.bg_image_desktop
  assign img_m = section.settings.bg_image_mobile
  if img_m == blank
    assign img_m = img_d
    assign mobile_fallback = true
  endif
-%}

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #tgs-enq-{{ sid }} {
    --enq-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --enq-heading-weight: {{ heading_font.weight }};
    --enq-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    --enq-body-weight: {{ body_font.weight }};
    --enq-bg: {{ section.settings.section_bg }};
    --enq-hero-text: {{ section.settings.hero_text_color }};
    --enq-eyebrow: {{ section.settings.eyebrow_color }};
    --enq-card-text: {{ section.settings.card_text_color }};
    --enq-card-alpha: {{ section.settings.card_opacity | divided_by: 100.0 }};
    --enq-field-alpha: {{ section.settings.field_opacity | divided_by: 100.0 }};
    --enq-btn-bg: {{ section.settings.button_bg }};
    --enq-btn-text: {{ section.settings.button_text_color }};
    --enq-link: {{ section.settings.link_color }};
    --enq-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --enq-h1-d: {{ section.settings.heading_size_desktop }}px;
    --enq-h1-m: {{ section.settings.heading_size_mobile }}px;
    --enq-h1-d-vw: {{ section.settings.heading_size_desktop | times: 100.0 | divided_by: 1440 }}vw;
    --enq-mobile-gap: {{ section.settings.mobile_image_gap }}vw;
    --enq-pt: {{ section.settings.padding_top }}px;
    --enq-pb: {{ section.settings.padding_bottom }}px;
    --enq-obj-pos: {{ section.settings.desktop_image_position }};
    --enq-himg-d: {{ section.settings.heading_image_width_desktop }}px;
    --enq-himg-m: {{ section.settings.heading_image_width_mobile }}vw;
  }
{%- endstyle -%}

<style>
  .tgs-enq {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--enq-bg);
    font-family: var(--enq-body-font);
    font-weight: var(--enq-body-weight);
    color: var(--enq-card-text);
    padding-bottom: var(--enq-pb);
  }
  .tgs-enq *, .tgs-enq *::before, .tgs-enq *::after { box-sizing: border-box; }

  /* ---------- Background media ---------- */
  .tgs-enq__media {
    position: absolute; inset: 0 0 auto 0; z-index: -2; margin: 0;
  }
  .tgs-enq__media img { display: block; width: 100%; height: auto; }
  .tgs-enq__media--fallback img { height: 120vw; object-fit: cover; object-position: center top; }
  .tgs-enq__media::after {
    /* fade bottom of the photo into the section background (mobile / tablet) */
    content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 35%;
    background: linear-gradient(to bottom, transparent, var(--enq-bg) 92%);
  }
  .tgs-enq__overlay {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: rgba(0,0,0,var(--enq-overlay));
  }
  .tgs-enq__placeholder { position: absolute; inset: 0; z-index: -2; background: #e9dccb; }
  .tgs-enq__placeholder svg { width: 100%; height: 100%; opacity: .25; }

  /* ---------- Top bar ---------- */
  .tgs-enq__topbar {
    position: relative;
    background: rgba(255,255,255,.28);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(255,255,255,.45);
    padding: 14px 16px;
  }
  .tgs-enq__topbar-inner {
    max-width: var(--page-width, 1300px); margin: 0 auto;
    display: flex; flex-wrap: nowrap; gap: 8px;
    justify-content: {{ section.settings.buttons_align_mobile }};
  }
  .tgs-enq__pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 11px; border-radius: 999px; border: 0;
    background: var(--enq-btn-bg); color: var(--enq-btn-text);
    font-family: var(--enq-body-font); font-weight: 700;
    font-size: clamp(8.5px, 2.3vw, 12px); letter-spacing: .08em; text-transform: uppercase;
    text-decoration: none; line-height: 1.2; cursor: pointer; white-space: nowrap;
    transition: transform .2s ease, opacity .2s ease;
  }
  .tgs-enq__pill:hover { opacity: .88; transform: translateY(-1px); color: var(--enq-btn-text); }
  .tgs-enq__pill svg { width: 16px; height: 16px; flex: 0 0 auto; }

  /* ---------- Layout ---------- */
  .tgs-enq__inner {
    max-width: var(--page-width, 1300px); margin: 0 auto;
    padding: calc(var(--enq-pt) * .6) 16px 0;
  }
  .tgs-enq--full .tgs-enq__topbar-inner,
  .tgs-enq--full .tgs-enq__inner { max-width: none; }
  .tgs-enq__hero { text-align: center; color: var(--enq-hero-text); }
  .tgs-enq__eyebrow {
    margin: 0 0 4px; color: var(--enq-eyebrow);
    font-family: var(--enq-body-font); font-weight: 600;
    font-size: clamp(11px, 3.3vw, 16px); letter-spacing: .14em; text-transform: uppercase;
  }
  .tgs-enq__title { margin: 0; font-family: var(--enq-heading-font); font-weight: var(--enq-heading-weight); color: inherit; line-height: .88; letter-spacing: -.01em; }
  .tgs-enq__title span { display: block; }
  .tgs-enq__l1 { font-size: var(--enq-h1-m); }
  .tgs-enq__l2 { font-size: calc(var(--enq-h1-m) * 1.55); }
  .tgs-enq__hero-inner { display: inline-block; text-align: left; }
  .tgs-enq__title--img { line-height: 0; }
  .tgs-enq__hero-img { display: block; margin: 0 auto; width: min(var(--enq-himg-m), 440px); max-width: 100%; }
  .tgs-enq__hero-img img { display: block; width: 100%; height: auto; }

  .tgs-enq__card-wrap { margin-top: var(--enq-mobile-gap); display: flex; justify-content: center; }

  /* ---------- Glass card ---------- */
  .tgs-enq__card {
    width: 100%; max-width: 760px;
    background: rgba(255,255,255,var(--enq-card-alpha));
    backdrop-filter: blur(16px) saturate(1.1); -webkit-backdrop-filter: blur(16px) saturate(1.1);
    border: 1.5px solid rgba(255,255,255,.85);
    border-radius: 24px;
    box-shadow: 0 30px 60px -20px rgba(40,25,10,.35);
    padding: 24px 18px 20px;
  }
  .tgs-enq__brand { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 14px; }
  .tgs-enq__brand img { height: 42px; width: auto; display: block; }
  .tgs-enq__brand-text { font-family: var(--enq-heading-font); font-size: 20px; letter-spacing: .14em; text-transform: uppercase; color: var(--enq-card-text); }
  .tgs-enq__form-title {
    margin: 0 0 16px; text-align: center;
    font-family: var(--enq-heading-font); font-weight: var(--enq-heading-weight);
    font-size: clamp(18px, 4.6vw, 28px); letter-spacing: .02em; line-height: 1.25; color: var(--enq-card-text);
  }

  /* ---------- Overrides for the shared corporate_native_form snippet ---------- */
  #tgs-enq-{{ sid }} .corporate-gifting-form {
    background: transparent; padding: 0; margin: 0; max-width: none; height: auto; border-radius: 0;
    font-family: var(--enq-body-font); color: var(--enq-card-text);
  }
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-title,
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-subtitle { display: none; }
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-row { display: flex; flex-direction: column; gap: 0; }
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-row.tgs-enq-hide { display: none; }
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group { margin-bottom: 12px; min-width: 0; }
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group label {
    font-size: 14px; font-weight: 500; margin: 0 0 6px 18px; color: var(--enq-card-text); letter-spacing: .02em;
  }
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group input,
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group select,
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group textarea {
    width: 100%; height: 46px; padding: 0 20px; margin: 0;
    font: inherit; font-size: 16px; color: var(--enq-card-text);
    background: rgba(255,255,255,var(--enq-field-alpha));
    border: 1px solid rgba(255,255,255,.9); border-radius: 999px;
    box-shadow: inset 0 1px 2px rgba(0,0,0,.04);
    outline: none; transition: border-color .2s, box-shadow .2s, background .2s;
    -webkit-appearance: none; appearance: none;
  }
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group textarea { height: 96px; padding: 14px 20px; border-radius: 26px; resize: vertical; }
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group input:focus,
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group select:focus,
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group textarea:focus {
    background: rgba(255,255,255,.95); border-color: rgba(0,0,0,.25); box-shadow: 0 0 0 3px rgba(255,255,255,.6);
  }
  {%- if section.settings.hide_placeholders -%}
  #tgs-enq-{{ sid }} .corporate-gifting-form ::placeholder { color: transparent; }
  {%- endif -%}
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group input.error-border,
  #tgs-enq-{{ sid }} .corporate-gifting-form .form-group textarea.error-border { border-color: #d22; }
  #tgs-enq-{{ sid }} .corporate-gifting-form .error { font-size: 12px; margin: 4px 0 0 18px; color: #c41a1a; }
  #tgs-enq-{{ sid }} .corporate-gifting-form .btn.btn-primary {
    display: block; margin: 16px auto 0; padding: 12px 24px; min-width: 190px;
    background: var(--enq-btn-bg); color: var(--enq-btn-text); border: 0; border-radius: 999px;
    font-family: var(--enq-body-font); font-weight: 700; font-size: 14px; letter-spacing: .2em; text-transform: uppercase;
    cursor: pointer; transition: opacity .2s, transform .2s;
  }
  #tgs-enq-{{ sid }} .corporate-gifting-form .btn.btn-primary:hover { opacity: .85; transform: translateY(-1px); background: var(--enq-btn-bg); }
  #tgs-enq-{{ sid }} .corporate-gifting-form .btn.btn-primary:disabled { opacity: .6; cursor: wait; }

  /* ---------- Contact row ---------- */
  .tgs-enq__contact {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
    gap: 12px 22px; margin-top: 20px; font-size: 13px; letter-spacing: .06em;
  }
  .tgs-enq__contact-label { width: 100%; text-align: center; color: var(--enq-card-text); }
  .tgs-enq__contact-item { display: inline-flex; align-items: center; gap: 10px; }
  .tgs-enq__contact-item svg { width: 30px; height: 30px; flex: 0 0 auto; color: var(--enq-card-text); }
  .tgs-enq__contact a { color: var(--enq-link); text-decoration: none; font-weight: 600; letter-spacing: .06em; }
  .tgs-enq__contact a:hover { text-decoration: underline; }
  .tgs-enq__phones { display: flex; flex-direction: column; line-height: 1.35; }

  /* ---------- Small phones ---------- */
  @media (max-width: 340px) {
    .tgs-enq__topbar-inner { flex-wrap: wrap; }
    .tgs-enq__topbar { padding: 12px 10px; }
  }

  /* ---------- Large phones / tablets (stacked layout, 2-col fields) ---------- */
  @media (min-width: 600px) {
    .tgs-enq__card { padding: 30px 22px 22px; border-radius: 28px; }
    #tgs-enq-{{ sid }} .corporate-gifting-form .form-row { flex-direction: row; gap: 14px; }
    .tgs-enq__contact { justify-content: space-between; flex-wrap: nowrap; gap: 16px; }
    .tgs-enq__contact-label { width: auto; text-align: left; }
    .tgs-enq__topbar-inner { gap: 14px; }
    .tgs-enq__pill { font-size: 12px; padding: 9px 16px; gap: 8px; letter-spacing: .14em; }
    .tgs-enq__pill svg { width: 20px; height: 20px; }
  }
  @media (min-width: 750px) {
    .tgs-enq__l1 { font-size: calc(var(--enq-h1-m) * 1.35); }
    .tgs-enq__l2 { font-size: calc(var(--enq-h1-m) * 1.35 * 1.55); }
    .tgs-enq__eyebrow { font-size: 17px; }
    .tgs-enq__topbar { padding: 18px 0; }
    .tgs-enq__topbar-inner { padding: 0 32px; }
    .tgs-enq__inner { padding-left: 32px; padding-right: 32px; }
    .tgs-enq__card { padding: 34px 26px 24px; }
  }

  /* ---------- Desktop / iPad landscape (two-column) ---------- */
  @media (min-width: 1100px) {
    .tgs-enq { min-height: {{ section.settings.desktop_min_height }}px; padding-bottom: var(--enq-pb); }
    .tgs-enq__media { inset: 0; }
    .tgs-enq__media img,
    .tgs-enq__media--fallback img { width: 100%; height: 100%; object-fit: cover; object-position: var(--enq-obj-pos); }
    .tgs-enq__media::after { display: none; }
    .tgs-enq__topbar { padding: 14px 0; }
    .tgs-enq__topbar-inner { padding: 0 clamp(32px, 4vw, 50px); }
    .tgs-enq__topbar-inner { justify-content: {{ section.settings.buttons_align_desktop }}; gap: 14px clamp(24px, 8vw, 170px); }
    .tgs-enq__inner {
      display: grid; align-items: start;
      grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
      gap: clamp(24px, 4vw, 80px);
      padding: var(--enq-pt) clamp(32px, 4vw, 50px) 0;
    }
    .tgs-enq--form-left .tgs-enq__hero { order: 2; }
    .tgs-enq__hero { text-align: left; padding-top: 0; }
    .tgs-enq__hero-img { margin: 0; width: var(--enq-himg-d); }
    .tgs-enq--form-left .tgs-enq__hero-img { margin-left: auto; }
    .tgs-enq__eyebrow { font-size: clamp(12px, 1.05vw, 16px); white-space: nowrap; }
    .tgs-enq__l1 { font-size: clamp(40px, var(--enq-h1-d-vw), var(--enq-h1-d)); }
    .tgs-enq__l2 { font-size: clamp(62px, calc(var(--enq-h1-d-vw) * 1.55), calc(var(--enq-h1-d) * 1.55)); }
    .tgs-enq__card-wrap { margin-top: 0; justify-content: flex-end; }
    .tgs-enq__card { max-width: 780px; padding: 36px 20px 22px; }
    .tgs-enq__brand { margin-bottom: 24px; }
    .tgs-enq__brand-text { font-size: 22px; }
    .tgs-enq__form-title { font-size: clamp(22px, 1.9vw, 28px); margin-bottom: 22px; }
    .tgs-enq__contact { margin-top: 26px; padding: 0 4px; }
  }
</style>

<section
  id="tgs-enq-{{ sid }}"
  class="tgs-enq{% if section.settings.desktop_layout == 'form_left' %} tgs-enq--form-left{% endif %}{% if section.settings.content_width == 'full' %} tgs-enq--full{% endif %}"
  data-section-id="{{ sid }}"
>
  {%- if img_d != blank or img_m != blank -%}
    <picture class="tgs-enq__media{% if mobile_fallback %} tgs-enq__media--fallback{% endif %}">
      {%- if img_d != blank -%}
        <source
          media="(min-width: 1100px)"
          srcset="{{ img_d | image_url: width: 1440 }} 1440w, {{ img_d | image_url: width: 1920 }} 1920w, {{ img_d | image_url: width: 2560 }} 2560w"
          sizes="100vw"
        >
      {%- endif -%}
      {{
        img_m
        | image_url: width: 1500
        | image_tag:
          widths: '375, 550, 750, 1000, 1200, 1500',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: img_m.alt
      }}
    </picture>
  {%- else -%}
    <div class="tgs-enq__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
  {%- endif -%}
  {%- if section.settings.overlay_opacity > 0 -%}<div class="tgs-enq__overlay" aria-hidden="true"></div>{%- endif -%}

  {%- if section.settings.show_topbar -%}
    <div class="tgs-enq__topbar">
      <div class="tgs-enq__topbar-inner">
        {%- if section.settings.button_1_text != blank -%}
          <a
            href="{{ section.settings.button_1_link | default: '#' }}"
            class="tgs-enq__pill js-tgs-enq-download"
            data-filename="{{ section.settings.catalogue_filename | escape }}"
            rel="noopener"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M12 6.5C10 5 6.5 4.5 3 5v13c3.5-.5 7 0 9 1.5 2-1.5 5.5-2 9-1.5V5c-3.5-.5-7 0-9 1.5Z"/><path d="M12 6.5v13M5.5 8.5c1.8-.1 3.6.2 4.6.8M5.5 11c1.8-.1 3.6.2 4.6.8M5.5 13.5c1.8-.1 3.6.2 4.6.8M13.9 9.3c1-.6 2.8-.9 4.6-.8M13.9 11.8c1-.6 2.8-.9 4.6-.8M13.9 14.3c1-.6 2.8-.9 4.6-.8"/></svg>
            <span>{{ section.settings.button_1_text }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_text != blank -%}
          <a href="{{ section.settings.button_2_link | default: '#' }}" class="tgs-enq__pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 20h14M3.5 20a6.5 6.5 0 0 1 13 0M10 13.5V12M8.5 12h3"/><path d="M15 9.5l3.5-4.5 3.5 1M17 7.4l-2 2.6" /><path d="M16.5 16.5c1.5-.3 3-1.4 4-3"/></svg>
            <span>{{ section.settings.button_2_text }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="tgs-enq__inner">
    {%- liquid
      assign h_img_d = section.settings.heading_image
      assign h_img_m = section.settings.heading_image_mobile
      if h_img_m == blank
        assign h_img_m = h_img_d
      endif
      assign h_alt = section.settings.eyebrow | append: ' ' | append: section.settings.heading_line_1 | append: ' ' | append: section.settings.heading_line_2 | strip | escape
    -%}
    {%- if h_img_m != blank -%}
      <div class="tgs-enq__hero">
        <h2 class="tgs-enq__title tgs-enq__title--img">
          <picture class="tgs-enq__hero-img">
            {%- if h_img_d != blank -%}
              <source media="(min-width: 1100px)" srcset="{{ h_img_d | image_url: width: 600 }} 600w, {{ h_img_d | image_url: width: 900 }} 900w, {{ h_img_d | image_url: width: 1400 }} 1400w" sizes="{{ section.settings.heading_image_width_desktop }}px">
            {%- endif -%}
            {{ h_img_m | image_url: width: 900 | image_tag: widths: '300, 450, 600, 900', sizes: '440px', loading: 'eager', alt: h_alt }}
          </picture>
        </h2>
      </div>
    {%- elsif section.settings.eyebrow != blank or section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
      <div class="tgs-enq__hero">
        <div class="tgs-enq__hero-inner">
          {%- if section.settings.eyebrow != blank -%}
            <p class="tgs-enq__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="tgs-enq__title">
            {%- if section.settings.heading_line_1 != blank -%}<span class="tgs-enq__l1">{{ section.settings.heading_line_1 }}</span>{%- endif -%}
            {%- if section.settings.heading_line_2 != blank -%}<span class="tgs-enq__l2">{{ section.settings.heading_line_2 }}</span>{%- endif -%}
          </h2>
        </div>
      </div>
    {%- endif -%}

    <div class="tgs-enq__card-wrap">
      <div class="tgs-enq__card">
        {%- if section.settings.logo != blank or section.settings.brand_text != blank -%}
          <div class="tgs-enq__brand">
            {%- if section.settings.logo != blank -%}
              {{
                section.settings.logo
                | image_url: width: 200
                | image_tag: loading: 'lazy', alt: section.settings.brand_text, style: 'height: 42px; width: auto;'
              }}
            {%- endif -%}
            {%- if section.settings.brand_text != blank -%}
              <span class="tgs-enq__brand-text">{{ section.settings.brand_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.form_title != blank -%}
          <h3 class="tgs-enq__form-title">{{ section.settings.form_title }}</h3>
        {%- endif -%}

        <div class="tgs-enq__form" data-show-extra="{{ section.settings.show_price_quantity }}">
          {% render 'corporate_native_form' %}
        </div>

        {%- if section.settings.contact_label != blank or section.settings.contact_email != blank or section.settings.phone_1 != blank -%}
          <div class="tgs-enq__contact">
            {%- if section.settings.contact_label != blank -%}
              <span class="tgs-enq__contact-label">{{ section.settings.contact_label }}</span>
            {%- endif -%}
            {%- if section.settings.contact_email != blank -%}
              <span class="tgs-enq__contact-item">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true"><path d="M3 13l13-9 13 9v15H3V13Z"/><path d="M3 13l13 9 13-9M3 28l10-8M29 28l-10-8"/><circle cx="16" cy="12" r="2.4"/><path d="M18.4 12v1c0 1.3 2 1.3 2-.4A4.4 4.4 0 1 0 18 16.4"/></svg>
                <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
              </span>
            {%- endif -%}
            {%- if section.settings.phone_1 != blank or section.settings.phone_2 != blank -%}
              <span class="tgs-enq__contact-item">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true"><path d="M8 5l4 1 2 6-3 2c1.5 3.2 3.8 5.5 7 7l2-3 6 2 1 4c-.5 2-2.5 3.5-4.5 3.2C13.6 26.6 5.4 18.4 4.8 9.5 4.5 7.5 6 5.5 8 5Z"/><path d="M19 4a9 9 0 0 1 9 9M19 8a5 5 0 0 1 5 5"/></svg>
                <span class="tgs-enq__phones">
                  {%- if section.settings.phone_1 != blank -%}
                    <a href="tel:{{ section.settings.phone_1 | remove: '-' | remove: ' ' }}">{{ section.settings.phone_1 }}</a>
                  {%- endif -%}
                  {%- if section.settings.phone_2 != blank -%}
                    <a href="tel:{{ section.settings.phone_2 | remove: '-' | remove: ' ' }}">{{ section.settings.phone_2 }}</a>
                  {%- endif -%}
                </span>
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('tgs-enq-{{ sid }}');
    if (!root) return;

    // Hide optional price range / quantity row unless enabled in the theme editor
    var wrap = root.querySelector('.tgs-enq__form');
    if (wrap && wrap.getAttribute('data-show-extra') !== 'true') {
      wrap.querySelectorAll('select').forEach(function (s) {
        var row = s.closest('.form-row');
        if (row) row.classList.add('tgs-enq-hide');
      });
    }

    // Catalogue download (falls back to opening the link if the browser blocks fetch)
    root.querySelectorAll('.js-tgs-enq-download').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        var url = btn.getAttribute('href');
        if (!url || url === '#') return;
        e.preventDefault();
        var name = btn.getAttribute('data-filename') || 'Catalogue.pdf';
        fetch(url)
          .then(function (r) { if (!r.ok) throw new Error(r.statusText); return r.blob(); })
          .then(function (blob) {
            var u = window.URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = u; a.download = name;
            document.body.appendChild(a); a.click();
            document.body.removeChild(a); window.URL.revokeObjectURL(u);
          })
          .catch(function () { window.open(url, '_blank', 'noopener'); });
      });
    });
  })();
</script>

