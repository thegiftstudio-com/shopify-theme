{% comment %}
  ============================================================================
  Express Delivery charge — shared config + cart enforcement + display.
  Added by Velocity 13-08-2026.

  The snippet loads its own shared utility and is rendered once globally for
  PDP selection, cart enforcement and cart-level delivery messaging.
  ============================================================================
{% endcomment %}

{{ 'express-delivery-utils.js' | asset_url | script_tag }}

<script>
(function () {
  if (window.__expressChargeInit) return;
  window.__expressChargeInit = true;

  var FALLBACK_CHARGE_VARIANT_ID = '53547247698227';
  var ExpressUtils = window.ExpressDeliveryUtils;
  window.EXPRESS_CHARGE_VARIANT_ID = FALLBACK_CHARGE_VARIANT_ID;

  // Added by Velocity 13-08-2026: fetch live prices for configured and fallback charge variants.
  var STOREFRONT_API_DOMAIN = 'tgs-revamp.myshopify.com';
  var STOREFRONT_API_VERSION = '2024-01';
  var STOREFRONT_API_TOKEN = '22ad5e2c245acbd1b0f1a27dd3d369ac';

  function fetchExpressChargeVariants(variantIds) {
    var uniqueIds = Array.from(new Set((variantIds || []).map(String).filter(function (id) {
      return /^\d+$/.test(id);
    })));
    if (!uniqueIds.length) return Promise.resolve({});

    var query = '' +
      'query ExpressChargeVariants($ids: [ID!]!) {' +
      '  nodes(ids: $ids) {' +
      '    ... on ProductVariant { id availableForSale price { amount } }' +
      '  }' +
      '}';

    return fetch('https://' + STOREFRONT_API_DOMAIN + '/api/' + STOREFRONT_API_VERSION + '/graphql.json', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Shopify-Storefront-Access-Token': STOREFRONT_API_TOKEN
      },
      body: JSON.stringify({
        query: query,
        variables: { ids: uniqueIds.map(function (id) { return 'gid://shopify/ProductVariant/' + id; }) }
      })
    }).then(function (response) {
      if (!response.ok) throw new Error('Storefront API returned status ' + response.status);
      return response.json();
    }).then(function (json) {
      if (json.errors && json.errors.length) throw new Error(json.errors[0].message);
      return ((json.data && json.data.nodes) || []).reduce(function (variants, node) {
        if (!node || !node.availableForSale || !node.price || node.price.amount == null) return variants;
        var variantId = String(node.id).split('/').pop();
        variants[variantId] = {
          variantId: variantId,
          pricePaise: Math.round(parseFloat(node.price.amount) * 100)
        };
        return variants;
      }, {});
    });
  }
  window.fetchExpressChargeVariants = fetchExpressChargeVariants;

  function hydratePdpExpressCharge() {
    var variantInput = document.getElementById('express_charge_variant_id');
    var priceInput = document.getElementById('express_charge_price_paise');
    if (!variantInput || !priceInput) return Promise.resolve({});

    var configuredId = variantInput.value || FALLBACK_CHARGE_VARIANT_ID;
    return fetchExpressChargeVariants([configuredId, FALLBACK_CHARGE_VARIANT_ID]).then(function (variants) {
      var charge = variants[configuredId] || variants[FALLBACK_CHARGE_VARIANT_ID];
      if (!charge) throw new Error('No available Express charge variant was returned');
      variantInput.value = charge.variantId;
      priceInput.value = charge.pricePaise;
      if (window.updateExpressChargeText) window.updateExpressChargeText();
      return charge;
    }).catch(function (error) {
      console.warn('[Express] PDP charge price fetch failed', error);
      return {};
    });
  }
  window.expressChargeReady = hydratePdpExpressCharge();

  // ---------------------------------------------------------------------------
  // Cart helpers
  // ---------------------------------------------------------------------------
  function isChargeLine(item) {
    return ExpressUtils.classifyLine(item) === 'charge';
  }

  function getCart() {
    return fetch('/cart.js', { headers: { 'Accept': 'application/json' } }).then(function (r) { return r.json(); });
  }

  function postJSON(url, body) {
    return fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(body)
    });
  }

  function postCart(url, body) {
    return postJSON(url, body).then(function (response) {
      if (response.ok) return response;
      return response.text().then(function (message) {
        throw new Error(message || ('Cart request failed with status ' + response.status));
      });
    });
  }

  function runSequentially(actions) {
    return actions.reduce(function (promise, action) {
      return promise.then(action);
    }, Promise.resolve());
  }

  // Added by Velocity 13-08-2026: hydrate cart charge prices before selecting the highest fee.
  function prepareEnforcementPlan(items) {
    var cartItems = items || [];
    var mainLines = cartItems.filter(function (item) {
      return ExpressUtils.classifyLine(item) === 'main';
    });

    if (!ExpressUtils.cartQualifiesForExpress(mainLines)) {
      return Promise.resolve(ExpressUtils.buildEnforcementPlan(cartItems, {
        variantId: FALLBACK_CHARGE_VARIANT_ID,
        pricePaise: null
      }));
    }

    var requestedIds = [FALLBACK_CHARGE_VARIANT_ID].concat(mainLines.map(function (item) {
      var configuredId = item.properties && item.properties._express_charge_variant_id;
      return /^\d+$/.test(String(configuredId || '')) ? String(configuredId) : FALLBACK_CHARGE_VARIANT_ID;
    }));

    return fetchExpressChargeVariants(requestedIds).then(function (variants) {
      var fallbackCharge = variants[FALLBACK_CHARGE_VARIANT_ID];
      if (!fallbackCharge) throw new Error('Fallback Express charge variant is unavailable');

      var pricedItems = cartItems.map(function (item) {
        if (ExpressUtils.classifyLine(item) !== 'main') return item;
        var properties = Object.assign({}, item.properties || {});
        var configuredId = /^\d+$/.test(String(properties._express_charge_variant_id || ''))
          ? String(properties._express_charge_variant_id)
          : FALLBACK_CHARGE_VARIANT_ID;
        var charge = variants[configuredId] || fallbackCharge;
        properties._express_charge_variant_id = charge.variantId;
        properties._express_charge_price_paise = String(charge.pricePaise);
        return Object.assign({}, item, { properties: properties });
      });

      return ExpressUtils.buildEnforcementPlan(pricedItems, fallbackCharge);
    });
  }

  // ---------------------------------------------------------------------------
  // Enforcement — single source of truth. Returns true ONLY when it changed the
  // cart (so callers re-render exactly once; idempotency terminates any loop).
  //   * all product lines express + eligible  -> exactly ONE charge (qty 1)
  //   * any other case                         -> no charge
  // ---------------------------------------------------------------------------
  function enforceExpressCharge() {
    return getCart().then(function (cart) {
      return prepareEnforcementPlan(cart.items || []).then(function (plan) {
      var actions = plan.removeChargeKeys.map(function (key) {
        return function () { return postCart('/cart/change.js', { id: key, quantity: 0 }); };
      });

      plan.standardUpdates.forEach(function (update) {
        actions.push(function () {
          return postCart('/cart/change.js', {
            id: update.key,
            quantity: update.quantity,
            properties: update.properties
          });
        });
      });

      if (plan.setChargeQuantity) {
        actions.push(function () {
          return postCart('/cart/change.js', {
            id: plan.setChargeQuantity.key,
            quantity: plan.setChargeQuantity.quantity
          });
        });
      }

      if (plan.addCharge) {
        actions.push(function () {
          return postCart('/cart/add.js', {
            id: plan.addCharge.variantId,
            quantity: 1,
            properties: { _is_express_charge: '1' }
          });
        });
      }

      if (!actions.length) return false;
      return runSequentially(actions).then(function () { return true; });
      });
    }).catch(function (err) {
      console.warn('[Express] enforce failed', err);
      return false;
    });
  }

  window.__expressEnforcing = false;
  window.__expressPending = false;
  // If a cart change arrives while we're mid-enforcement, don't drop it — queue exactly
  // one re-run so the FINAL cart state is always enforced (prevents "charge not re-added"
  // races on rapid add/remove). The aggregated `changed` bubbles to the first caller.
  function runExpressEnforcement() {
    if (window.__expressEnforcing) { window.__expressPending = true; return Promise.resolve(false); }
    window.__expressEnforcing = true;
    return enforceExpressCharge().then(function (changed) {
      window.__expressEnforcing = false;
      if (window.__expressPending) {
        window.__expressPending = false;
        return runExpressEnforcement().then(function (c) { return changed || c; });
      }
      return changed;
    }, function (err) {
      window.__expressEnforcing = false;
      console.warn('[Express] enforce failed', err);
      return false;
    });
  }
  window.runExpressEnforcement = runExpressEnforcement;

  // ---------------------------------------------------------------------------
  // Cart-level delivery note ("latest date wins") + charge note toggle.
  // ---------------------------------------------------------------------------
  function parseDMY(str) {
    if (!str) return null;
    var p = String(str).split('-');
    if (p.length < 3) return null;
    var d = parseInt(p[0], 10), m = parseInt(p[1], 10), y = parseInt(p[2], 10);
    if (y < 100) y += 2000;
    if (!d || !m || !y) return null;
    return new Date(y, m - 1, d);
  }
  function maxDate(dates) {
    var valid = dates.filter(Boolean);
    if (!valid.length) return null;
    return valid.reduce(function (a, b) { return b > a ? b : a; });
  }
  function fmtPromise(date) {
    if (!date) return '';
    var today = new Date(); today.setHours(0, 0, 0, 0);
    var d = new Date(date); d.setHours(0, 0, 0, 0);
    var diff = Math.round((d - today) / 86400000);
    if (diff <= 0) return 'today';
    if (diff === 1) return 'tomorrow';
    var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return d.getDate() + ' ' + months[d.getMonth()];
  }

  function refreshExpressDisplay() {
    return getCart().then(function (cart) {
      var items = cart.items || [];
      var productLines = items.filter(function (it) { return ExpressUtils.classifyLine(it) === 'main'; });
      var allExpress = ExpressUtils.cartQualifiesForExpress(productLines);

      var text = '';
      if (productLines.length && allExpress) {
        var exp = maxDate(productLines.map(function (it) { return parseDMY(it.properties && it.properties._express_date); }));
        if (exp) text = 'Express delivery by ' + fmtPromise(exp);
      }

      document.querySelectorAll('.express-delivery-summary').forEach(function (el) {
        if (text) { el.textContent = text; el.style.display = ''; }
        else { el.textContent = ''; el.style.display = 'none'; }
      });
    }).catch(function () {});
  }
  window.refreshExpressDisplay = refreshExpressDisplay;

  // Added by Velocity on 25-08-2026: refresh the custom drawer wrapper itself.
  // The theme drawer is not rendered by Dawn's section-only renderer, so a
  // section response can leave the old footer or Express charge visible.
  function refreshCustomCartDrawer() {
    var currentRoot = document.getElementById('CartDrawer_MainContent');
    if (!currentRoot) return Promise.resolve();

    var separator = window.location.href.indexOf('?') === -1 ? '?' : '&';
    return fetch(window.location.href.split('#')[0] + separator + 'express_refresh=' + Date.now(), {
      cache: 'no-store',
      headers: { 'Accept': 'text/html' }
    }).then(function (response) {
      if (!response.ok) throw new Error('Cart drawer refresh returned status ' + response.status);
      return response.text();
    }).then(function (html) {
      var parsed = new DOMParser().parseFromString(html, 'text/html');
      var source = parsed.querySelector('#CartDrawer_MainContent > div');
      var target = currentRoot.querySelector(':scope > div');
      if (!source || !target) return;
      target.replaceWith(source.cloneNode(true));
      var drawer = document.querySelector('cart-drawer');
      var empty = !!(drawer && drawer.querySelector('.drawer__inner-empty'));
      if (drawer) {
        drawer.classList.toggle('is-empty', empty);
        drawer.classList.add('active');
      }
      if (typeof window.handleCartDrawer === 'function') window.handleCartDrawer();
    }).catch(function (error) {
      console.warn('[Express] custom drawer refresh failed', error);
    });
  }
  window.refreshCustomCartDrawer = refreshCustomCartDrawer;

  // Added by Velocity 13-08-2026: rebuild every cart surface from the final
  // enforced state so removing the last Express product leaves no stale fee UI.
  function replaceSectionContent(sections, sectionKey, sourceSelector, currentRootId, currentSelector) {
    if (!sections || !sections[sectionKey]) return null;
    var doc = new DOMParser().parseFromString(sections[sectionKey], 'text/html');
    var source = doc.querySelector(sourceSelector);
    var currentRoot = document.getElementById(currentRootId);
    var current = currentRoot && (currentRoot.querySelector(currentSelector) || currentRoot);
    if (source && current) current.innerHTML = source.innerHTML;
    return source;
  }

  function refreshExpressCartSections() {
    var sectionKeys = ['cart-drawer', 'cart-icon-bubble', 'main-cart-items', 'main-cart-footer'];
    return fetch('/cart?sections=' + sectionKeys.join(',') + '&express_refresh=' + Date.now(), {
      cache: 'no-store',
      headers: { 'Accept': 'application/json' }
    })
      .then(function (response) {
        if (!response.ok) throw new Error('Cart sections returned status ' + response.status);
        return response.json();
      })
      .then(function (sections) {
        var drawerSource = replaceSectionContent(sections, 'cart-drawer', '.drawer__inner', 'CartDrawer', '.drawer__inner');
        replaceSectionContent(sections, 'cart-icon-bubble', '.shopify-section', 'cart-icon-bubble', '.shopify-section');
        replaceSectionContent(sections, 'main-cart-items', '.js-contents', 'main-cart-items', '.js-contents');
        replaceSectionContent(sections, 'main-cart-footer', '.js-contents', 'main-cart-footer', '.js-contents');

        var isEmpty = !!(drawerSource && drawerSource.querySelector('.drawer__inner-empty'));
        var drawer = document.querySelector('cart-drawer');
        var drawerItems = drawer && drawer.querySelector('cart-drawer-items');
        var cartItems = document.getElementById('main-cart-items');
        var cartFooter = document.getElementById('main-cart-footer');
        if (drawer) drawer.classList.toggle('is-empty', isEmpty);
        if (drawerItems) drawerItems.classList.toggle('is-empty', isEmpty);
        if (cartItems) cartItems.classList.toggle('is-empty', isEmpty);
        if (cartFooter) cartFooter.classList.toggle('is-empty', isEmpty);
      })
      .catch(function (error) {
        console.warn('[Express] cart section refresh failed', error);
      });
  }
  window.refreshExpressCartSections = refreshExpressCartSections;

  function reflectChange() {
    return refreshCustomCartDrawer()
      .then(refreshExpressCartSections)
      .then(refreshExpressDisplay);
  }

  // ---------------------------------------------------------------------------
  // Wire-up: react to every cart update. Ignore our OWN re-render publish to
  // avoid re-running enforcement (display still refreshes). Idempotency means
  // even if it did run again it would converge with no change.
  // ---------------------------------------------------------------------------
  function onCartUpdated(event) {
    if (event && event.source === 'express-charge') { reflectChange(); return; }
    runExpressEnforcement().then(function (changed) {
      if (changed) { reflectChange(); } else { refreshCustomCartDrawer().then(refreshExpressCartSections).then(refreshExpressDisplay); }
    });
  }

  if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
    subscribe(PUB_SUB_EVENTS.cartUpdate, onCartUpdated);
  }

  // The PDP Add-to-Cart (cart_drawer_func.js) uses jQuery.ajax to /cart/add.js and does
  // NOT publish cartUpdate, so the subscriber above never fires for it. ajaxComplete fires
  // after EVERY jQuery request; we filter to cart mutations. Our own writes use fetch(),
  // so they never re-trigger this -> no loop. This makes enforcement work even if the
  // cart_drawer_func.js hook is not deployed.
  if (window.jQuery) {
    window.jQuery(document).ajaxComplete(function (event, xhr, settings) {
      var url = (settings && settings.url) || '';
      if (/\/cart\/(add|change|update)(\.js)?/.test(url)) {
        runExpressEnforcement().then(function (changed) {
          if (changed) { reflectChange(); } else { refreshCustomCartDrawer().then(refreshExpressCartSections).then(refreshExpressDisplay); }
        });
      }
    });
  }

  // Explicit safety-net on product removal: when any cart-remove control is clicked, the
  // removal is async, so we re-check the cart shortly after it commits. If any eligible
  // Express product still remains, the fee is (re-)added on that remaining product set;
  // if none remain, the orphan fee is removed. Idempotent, so it layers safely on top of
  // the cartUpdate subscriber above.
  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest &&
      e.target.closest('cart-remove-button, .cart-remove-button, [data-cart-remove], a[href*="/cart/change"]');
    if (!btn) return;
    // Removal is async; re-check a couple of times after it commits (idempotent).
    [400, 900].forEach(function (delay) {
      setTimeout(function () {
        runExpressEnforcement().then(function (changed) {
          if (changed) { reflectChange(); } else { refreshCustomCartDrawer().then(refreshExpressCartSections).then(refreshExpressDisplay); }
        });
      }, delay);
    });
  }, true);

  // On every page load, converge the cart to a valid state, then paint the note.
  document.addEventListener('DOMContentLoaded', function () {
    runExpressEnforcement().then(function (changed) {
      if (changed) { reflectChange(); } else { refreshCustomCartDrawer().then(refreshExpressCartSections).then(refreshExpressDisplay); }
    });
  });
})();
</script>
