<input
  type="hidden"
  id="ProductSelected-variant"
  class="input_variant"
  name="id"
  value="{{ product.selected_or_first_available_variant.id }}"
>

{% if product.tags contains 'location-roi' %}
  {% assign isRoiProduct = true %}
{% else %}
  {% assign isRoiProduct = false %}
{% endif %}








{% comment %}
  Display Rakhi add-on products from the rakhis collection on PDPs tagged with rakhi-section. Added by Velocity on 12-08-2026
  Removed Rakhi section on 01-09-2026 as per Aniket Requested,
{% endcomment %}
{% if product.tags contains 'rakhi-section-removed' or product.collections contains collections['rakhis-removed'] %}
  {% if product.tags contains 'addon-section' or product.collections contains collections['rakhis'] %} 
  {% assign section_heading = 'Add a Little More' %}
  {% assign selected_product = 'Selected Product : ' %}
  {% assign no_product = 'No Product' %}
  {% assign collection_product = collections.add-ons-india.products %}
{% else %}
    {% assign section_heading = 'Add Rakhi' %}
  {% assign selected_product = 'Selected Rakhi : ' %}
  {% assign no_product = 'No Rakhi' %}
  {% assign collection_product = collections.rakhis.products %}
{% endif %}
  <div class="product__accordion accordion quick-add-hidden">
    <details id="Details-rakhi-section-{{ section.id }}" open>
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title">{{section_heading}}</h2>
        </div>
        {% render 'icon-caret' %}
      </summary>

      <div class="accordion__content rte" id="ProductAccordion-rakhi-section-{{ section.id }}">
        <div class="rakhi_addon_wrapper" data-roi="{{ isRoiProduct }}">
          <h4>{{selected_product}}<span class="show_rakhi_prod_name"></span><span class="show_rakhi_prod_price"></span></h4>
          <div class="gift_products_wrap">
            <div class="gift_product no_rakhi_product">
              <input type="radio" id="no_rakhi" class="rakhi_product_checkbox" name="rakhi_product_id" value="" checked>
              <span class="no_rakhi_label">{{no_product}}</span>
              <input type="hidden" value="" class="rakhi_pd_name">
              <input type="hidden" value="" class="rakhi_pd_price">
            </div>
            {% for rakhi_product in collection_product %}
              {% assign rakhi_mumbai_inventory = rakhi_product.metafields.custom.mumbai_inventory | default: 0 %}
              {% assign rakhi_gurgaon_inventory = rakhi_product.metafields.custom.gurgaon_inventory | default: 0 %}
              {% assign rakhi_bangalore_inventory = rakhi_product.metafields.custom.bangalore_inventory | default: 0 %}

              {% if isRoiProduct and rakhi_product.tags contains 'location-roi' %}
                <div class="gift_product rakhi_addon_product"
                     data-mumbai-inventory="{{ rakhi_mumbai_inventory }}"
                     data-gurgaon-inventory="{{ rakhi_gurgaon_inventory }}"
                     data-bangalore-inventory="{{ rakhi_bangalore_inventory }}">
                  <input type="radio" class="rakhi_product_checkbox"
                    name="rakhi_product_id" value="{{ rakhi_product.selected_or_first_available_variant.id }}">
                  <img src="{{ rakhi_product.featured_media.preview_image | img_url:'100x100' }}" alt="{{ rakhi_product.title | escape }}">
                  <input type="hidden" value="{{ rakhi_product.title | escape }}" class="rakhi_pd_name">
                  <input type="hidden" value="{{ rakhi_product.selected_or_first_available_variant.price }}" class="rakhi_pd_price">
                  <div class="tooltip_product_info">
                    {% if rakhi_product.images.size > 1 %}
                      <img src="{{ rakhi_product.images[1] | img_url:'master' }}" alt="{{ rakhi_product.title | escape }}">
                    {% else %}
                      <img src="{{ rakhi_product.featured_media.preview_image | img_url:'master' }}" alt="{{ rakhi_product.title | escape }}">
                    {% endif %}
                  </div>
                </div>
              {% elsif isRoiProduct == false %}
                {% unless rakhi_product.tags contains 'location-roi' %}
                  <div class="gift_product rakhi_addon_product"
                       data-mumbai-inventory="{{ rakhi_mumbai_inventory }}"
                       data-gurgaon-inventory="{{ rakhi_gurgaon_inventory }}"
                       data-bangalore-inventory="{{ rakhi_bangalore_inventory }}">
                    <input type="radio" class="rakhi_product_checkbox"
                      name="rakhi_product_id" value="{{ rakhi_product.selected_or_first_available_variant.id }}">
                    <img src="{{ rakhi_product.featured_media.preview_image | img_url:'100x100' }}" alt="{{ rakhi_product.title | escape }}">
                    <input type="hidden" value="{{ rakhi_product.title | escape }}" class="rakhi_pd_name">
                    <input type="hidden" value="{{ rakhi_product.selected_or_first_available_variant.price }}" class="rakhi_pd_price">
                    <div class="tooltip_product_info">
                      {% if rakhi_product.images.size > 1 %}
                        <img src="{{ rakhi_product.images[1] | img_url:'master' }}" alt="{{ rakhi_product.title | escape }}">
                      {% else %}
                        <img src="{{ rakhi_product.featured_media.preview_image | img_url:'master' }}" alt="{{ rakhi_product.title | escape }}">
                      {% endif %}
                    </div>
                  </div>
                {% endunless %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </details>
  </div>
{% endif %}

{% if render_addons_product  %}

  <product-recommendations
                class="complementary-products quick-add-hidden no-js-hidden{% if render_addons_product.settings.make_collapsible_row %} is-accordion{% endif %}{% if render_addons_product.settings.enable_quick_add %} complementary-products-contains-quick-add{% endif %}"
                data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ render_addons_product.settings.product_list_limit }}&intent=complementary"
              >
                {%- if recommendations.performed and recommendations.products_count > 0 -%}
                  <aside
                    aria-label="{{ 'accessibility.complementary_products' | t }}"
                    {{ render_addons_product.shopify_attributes -}}
                    {% if render_addons_product.settings.make_collapsible_row %}
                      class="product__accordion accordion"
                    {% endif %}
                  >
                    <div class="complementary-products__container">
                      {%- if render_addons_product.settings.make_collapsible_row -%}
                        <details id="Details-{{ render_addons_product.id }}-{{ section.id }}" open>
                          <summary>
                      {%- endif %}
                      <div class="summary__title">
                        {%- if render_addons_product.settings.make_collapsible_row -%}
                          {% render 'icon-accordion', icon: render_addons_product.settings.icon %}
                          <h2 class="h4 accordion__title">{{ render_addons_product.settings.block_heading }}</h2>
                        {%- else -%}
                          <h2 class="h3 accordion__title">{{ render_addons_product.settings.block_heading }}</h2>
                        {%- endif -%}
                      </div>
                      {%- if render_addons_product.settings.make_collapsible_row -%}
                        {% render 'icon-caret' %}
                        </summary>
                      {%- endif -%}
                      <slideshow-component class="slider-mobile-gutter">
                        {%- assign number_of_slides = recommendations.products_count
                          | plus: 0.0
                          | divided_by: render_addons_product.settings.products_per_page
                          | ceil
                        -%}
                        <div
                          id="Slider-{{ render_addons_product.id }}"
                          class="contains-card contains-card--product complementary-slider grid grid--1-col slider slider--everywhere"
                          role="list"
                          {% if number_of_slides > 1 %}
                            aria-label="{{ 'general.slider.name' | t }}"
                          {% endif %}
                        >
                          {%- for i in (1..number_of_slides) -%}
                            <div
                              id="Slide-{{ render_addons_product.id }}-{{ forloop.index }}"
                              class="complementary-slide complementary-slide--{{ settings.card_style }} grid__item slider__slide slideshow__slide"
                              tabindex="-1"
                              role="group"
                              {% if number_of_slides > 1 %}
                                aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                              {% endif %}
                            >
                              <ul class="list-unstyled" role="list">
                                {%- for product in recommendations.products
                                  limit: render_addons_product.settings.products_per_page
                                  offset: continue
                                -%}
                                  <li
                                    data-complementary-product-id="{{ product.id }}"
                                    data_mumbai="{{ product.metafields.custom.mumbai_inventory }}"
                                    data_kolkata="{{ product.metafields.custom.kolkata_inventory }}"
                                    data_gurgaon="{{ product.metafields.custom.gurgaon_inventory }}"
                                    data_delhi="{{ product.metafields.custom.delhi_inventory }}"
                                    data_bangalore="{{ product.metafields.custom.bangalore_inventory }}"
                                    {% if product.tags contains 'Warehouse' %}data-always-show="true"{% endif %}
                                  >
                                    {% render 'card-product',
                                      card_product: product,
                                      media_aspect_ratio: render_addons_product.settings.image_ratio,
                                      show_secondary_image: false,
                                      lazy_load: true,
                                      show_quick_add: render_addons_product.settings.enable_quick_add,
                                      section_id: section.id,
                                      horizontal_class: true,
                                      horizontal_quick_add: true
                                    %}
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          {%- endfor -%}
                        </div>
                        {%- if number_of_slides > 1 -%}
                          <div class="slider-buttons no-js-hidden">
                            <button
                              type="button"
                              class="slider-button slider-button--prev"
                              name="previous"
                              aria-label="{{ 'general.slider.previous_slide' | t }}"
                            >
                              {% render 'icon-caret' %}
                            </button>
                            <div class="slider-counter slider-counter--{{ render_addons_product.settings.pagination_style }}{% if render_addons_product.settings.pagination_style == 'counter' or render_addons_product.settings.pagination_style == 'numbers' %} caption{% endif %}">
                              {%- if render_addons_product.settings.pagination_style == 'counter' -%}
                                <span class="slider-counter--current">1</span>
                                <span aria-hidden="true"> / </span>
                                <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                                <span class="slider-counter--total">{{ number_of_slides }}</span>
                              {%- else -%}
                                <div class="slideshow__control-wrapper">
                                  {%- for i in (1..number_of_slides) -%}
                                    <button
                                      class="slider-counter__link slider-counter__link--{{ render_addons_product.settings.pagination_style }} link"
                                      aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                      aria-controls="Slider-{{ render_addons_product.id }}"
                                    >
                                      {%- if render_addons_product.settings.pagination_style == 'numbers' -%}
                                        {{ forloop.index -}}
                                      {%- else -%}
                                        <span class="dot"></span>
                                      {%- endif -%}
                                    </button>
                                  {%- endfor -%}
                                </div>
                              {%- endif -%}
                            </div>
                            <button
                              type="button"
                              class="slider-button slider-button--next"
                              name="next"
                              aria-label="{{ 'general.slider.next_slide' | t }}"
                            >
                              {% render 'icon-caret' %}
                            </button>
                          </div>
                        {%- endif -%}
                      </slideshow-component>
                      {%- if render_addons_product.settings.make_collapsible_row -%}
                        </details>
                      {%- endif -%}
                    </div>
                  </aside>
                {%- endif -%}
                {{ 'component-card.aio.min.css' | asset_url | stylesheet_tag }}
                {{ 'component-complementary-products.aio.min.css' | asset_url | stylesheet_tag }}
                {%- if render_addons_product.settings.enable_quick_add -%}
                  <link
                    rel="stylesheet"
                    href="{{ 'quick-add.aio.min.css' | asset_url }}"
                    media="print"
                    onload="this.media='all'"
                  >
                  <script src="{{ 'quick-add.aio.min.js' | asset_url }}" defer="defer"></script>
                {%- endif -%}
              </product-recommendations>


  {% endif %}


{% if product.tags contains 'sleeve-section' %}
  <div class="sleeve_wrapper">
    {% if product.tags contains 'Liquor' %}
      <h4 style="padding-bottom: 5px;">Choose Packaging : <span class="show_sleeve_pd_name"></span></h4>
    {% else %}
      <h4>Choose Sleeve : <span class="show_sleeve_pd_name"></span></h4>
    {% endif %}

    <div class="sleeve_products_wrap">
      {% if product.tags contains 'Liquor' %}
      {% elsif product.tags contains 'bestseller-ateliers' %}
        <div class="slv_product default_slv_product">
          <input type="radio" class="sleeve_product_checkbox" name="sleeve_product_id" value="">
          <img src="{{ 'no_sleeve.jpg' | asset_img_url:'100x100' }}">
          <input type="hidden" value="" class="sleeve_pd_name">
        </div>
      {% else %}
        <div class="slv_product default_slv_product">
          <input type="radio" class="sleeve_product_checkbox" name="sleeve_product_id" value="">
          <img src="{{ 'no_sleeve.jpg' | asset_img_url:'100x100' }}">
          <input type="hidden" value="" class="sleeve_pd_name">
        </div>
      {% endif %}

      {% for slv_product in collections.sleeve.products %}
        {% for tag in slv_product.tags %}
          {% if tag contains 'sleeve' %}
            {% for pd_tag in product.tags %}
              {% if pd_tag contains 'sleeve' %}
                {% if pd_tag == tag %}
                  <div class="slv_product {% for tag in slv_product.tags %}{% if tag contains "sleeve" %}{{ tag }} {% endif %}{% endfor %}">
                    <input
                      type="radio"
                      class="sleeve_product_checkbox"
                      name="sleeve_product_id"
                      {% for variant in slv_product.variants %}
                        value="{{ variant.id }}"
                      {% endfor %}
                    >
                    <img src="{{ slv_product.featured_media.preview_image | img_url:'100x100' }}">
                    {% if product.tags contains 'Liquor' %}
                      <p>{{ slv_product.price | money }}</p>
                    {% endif %}
                    <input type="hidden" value="{{ slv_product.title }}" class="sleeve_pd_name">
                    <div class="tooltip_product_info">
                      {% if slv_product.images.size > 1 %}
                        <img src="{{ slv_product.images[1] | img_url:'master' }}">
                      {% else %}
                        <img src="{{ slv_product.featured_media.preview_image | img_url:'master' }}">
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
{% endif %}
{% if product.tags contains 'card-section' %}
  {% comment %}
   Add accordion in Gift card section to make it collapsable and by default open the collapsable gift section. Added by Velocity 10-07-2025
  {% endcomment %}
  <div class="product__accordion accordion quick-add-hidden">
    <details id="Details-card-section-{{ section.id }}" open>
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title">Add Gift Card</h2>
        </div>
        {% render 'icon-caret' %}
      </summary>

      <div class="accordion__content rte" id="ProductAccordion-card-section-{{ section.id }}">
  <div class="gift_card_wrapper" data-roi="{{ isRoiProduct }}">
    <h4>Add Gift Card : <span class="show_gift_prod_name"></span><span class="show_gift_prod_price"></span></h4>
    <div class="gift_products_wrap">
      <div class="gift_product">
        <input type="radio" id="no_card" class="gift_product_checkbox" name="product_id" value="">
        <img src="{{ 'no_card.jpg' | asset_img_url:'100x100' }}">
        <input type="hidden" value="" class="gift_pd_name">
   {% comment %}
   Add Price of the Gift Card. Added by Velocity 10-07-2025
  {% endcomment %}
        <input type="hidden" value="" class="gift_pd_price">
        
      </div>
      {% assign collection_handle = product.metafields.custom.collection_name.value %}
  <input type="hidden" value="{{ collection_handle}}" class="collection_name">
      {% assign sorted_card_products = collections.card.products %}
      {% for product in sorted_card_products %}
        {% comment %}
        Get card inventory data for warehouse filtering
        Added warehouse-based card filtering - Added by Velocity 13-08-2025
        {% endcomment %}
        {% assign card_mumbai_inventory = product.metafields.custom.mumbai_inventory | default: 0 %}
        {% assign card_gurgaon_inventory = product.metafields.custom.gurgaon_inventory | default: 0 %}
        {% assign card_bangalore_inventory = product.metafields.custom.bangalore_inventory | default: 0 %}
        {% if isRoiProduct and product.tags contains 'location-roi' %}
          <div class="gift_product gift_card_product" 
               data-mumbai-inventory="{{ card_mumbai_inventory }}"
               data-gurgaon-inventory="{{ card_gurgaon_inventory }}"
               data-bangalore-inventory="{{ card_bangalore_inventory }}">
            <input
              type="radio"
              class="gift_product_checkbox"
              name="product_id"
              {% for variant in product.variants %}
                value="{{ variant.id }}"
              {% endfor %}
            >
            <img src="{{ product.featured_media.preview_image | img_url:'100x100' }}">
            <input type="hidden" value="{{ product.title }}" class="gift_pd_name">
             {% comment %}
   To add the Price of the Gift Card. Added by Velocity 10-07-2025
  {% endcomment %}
            <input type="hidden" value="{{ product.variants[0].price }}" class="gift_pd_price">
            <div class="tooltip_product_info">
              {% if product.images.size > 1 %}
                <img src="{{ product.images[1] | img_url:'master' }}">
              {% else %}
                <img src="{{ product.featured_media.preview_image | img_url:'master' }}">
              {% endif %}
            </div>
          </div>
        {% elsif isRoiProduct == false %}
          {% unless product.tags contains 'location-roi' %}
              <div class="gift_product gift_card_product"
                   data-mumbai-inventory="{{ card_mumbai_inventory }}"
                   data-gurgaon-inventory="{{ card_gurgaon_inventory }}"
                   data-bangalore-inventory="{{ card_bangalore_inventory }}">
                <input
                  type="radio"
                  class="gift_product_checkbox"
                  name="product_id"
                  {% for variant in product.variants %}
                    value="{{ variant.id }}"
                  {% endfor %}
                >
                <img src="{{ product.featured_media.preview_image | img_url:'100x100' }}">
                <input type="hidden" value="{{ product.title }}" class="gift_pd_name">
                <input type="hidden" value="{{ product.variants[0].price }}" class="gift_pd_price">
                <div class="tooltip_product_info">
                  {% if product.images.size > 1 %}
                    <img src="{{ product.images[1] | img_url:'master' }}">
                  {% else %}
                    <img src="{{ product.featured_media.preview_image | img_url:'master' }}">
                  {% endif %}
                </div>
              </div>
          {% endunless %}
        {% endif %}
      {% endfor %}
    </div>
    <div class="card_msg_wrapper">
      <h5>Message on card:</h5>
      <textarea id="gift_card_msg"></textarea>
      <p class="card_msg_error"></p>
      <span class="custom_msg_error"></span>
    </div>
  </div>
      </div>
    </details>
  </div>
{% endif %}

